{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "BedrockInvokeModelStatement",
            "Effect": "Allow",
            "Action": [
                "bedrock:InvokeModel"
            ],
            "Resource": [
                "arn:aws:bedrock:${aws_region}::foundation-model/amazon.titan-embed-text-v2:0",
                "arn:aws:bedrock:${aws_region}::foundation-model/anthropic.claude-v2",
                "arn:aws:bedrock:${aws_region}::foundation-model/anthropic.claude-3-5-sonnet-20240620-v1:0",
                "arn:aws:bedrock:${aws_region}::foundation-model/anthropic.claude-3-haiku-20240307-v1:0"
            ]
        },
        {
            "Sid": "OpenSearchServerlessAPIAccessAllStatement",
            "Effect": "Allow",
            "Action": [
                "aoss:APIAccessAll"
            ],
            "Resource": [
                "arn:aws:aoss:${aws_region}:${account_id}:collection/*"
            ]
        },
        {
            "Sid": "S3ListBucketStatement",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket",
                "s3:GetObject",
                "s3:GetObjectVersion"
            ],
            "Resource": [
                "${s3_bucket_arn}",
                "${s3_bucket_arn}/*",
                "arn:aws:s3:::lhlanonp-providerp2p-kb-input",
                "arn:aws:s3:::lhlanonp-providerp2p-kb-input/*"
            ]
        }
    ]
}
